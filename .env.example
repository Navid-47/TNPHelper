# ─────────────────────────────────────────────────────────────────────────────
# TNPHelper — .env.example
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────

# Required in production (DEBUG=False). Generate with:
#   python -c "from django.utils.crypto import get_random_string; print(get_random_string(50))"
SECRET_KEY=replace-me-with-a-long-random-secret-key

# Set to False in production. Set to True for local development only.
DEBUG=False

# Comma-separated list of allowed hostnames (no wildcards in production).
# Example: ALLOWED_HOSTS=tnphelper.example.com,www.tnphelper.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (include scheme).
# Example: CSRF_TRUSTED_ORIGINS=https://tnphelper.example.com
CSRF_TRUSTED_ORIGINS=

# ── Database (MySQL / Amazon RDS) ────────────────────────────────────────────

DB_NAME=tnp_db
DB_USER=tnphelper
DB_PASSWORD=replace-me-with-db-password
DB_HOST=localhost
DB_PORT=3306

# ── File upload limits ────────────────────────────────────────────────────────

# Maximum resume upload size in bytes. Default: 5242880 (5 MB).
MAX_RESUME_SIZE=5242880

# Maximum total request body size in bytes. Must be >= MAX_RESUME_SIZE + overhead.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# ── Production security settings (only applied when DEBUG=False) ──────────────

# Redirect all HTTP requests to HTTPS. Set to False if Nginx handles redirects.
SECURE_SSL_REDIRECT=True

# HSTS duration in seconds (31536000 = 1 year). Set to 0 to disable.
SECURE_HSTS_SECONDS=31536000

# Include subdomains in HSTS header. Enable only after confirming all subdomains serve HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Add this site to the HSTS preload list. Enable only after careful consideration.
SECURE_HSTS_PRELOAD=False

# Secure session and CSRF cookies (always True in production).
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
